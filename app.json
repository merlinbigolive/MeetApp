
{
  "expo": {
    "name": "USay",
    "slug": "meetapp",
    "scheme": "meetapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetapp.social"
    },
    "android": {
      "package": "com.meetapp.social",
      "adaptiveIcon": {
        "backgroundColor": "#F5FAFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow USay to access your photos.",
          "cameraPermission": "Allow USay to use your camera."
        }
      ]
    ]
  }
}
