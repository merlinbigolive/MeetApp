{
  "expo": {
    "owner": "meetappindias-team",
    "name": "MEEi",
    "slug": "meetapp",
    "scheme": "meetapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetapp.social",
      "infoPlist": {
        "NSCameraUsageDescription": "MEEi uses your camera to broadcast live video and join video experiences.",
        "NSMicrophoneUsageDescription": "MEEi uses your microphone for live broadcasts and voice chat."
      }
    },
    "android": {
      "package": "com.meetapp.social",
      "adaptiveIcon": {
        "backgroundColor": "#F5FAFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MEEi to find people you know who have chosen to be discoverable."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MEEi to access your photos.",
          "cameraPermission": "Allow MEEi to use your camera."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow MEEi to record voice messages.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/cuckoo_default_natural.wav"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow MEEi to record voice messages.",
          "speechRecognitionPermission": "Allow MEEi to transcribe voice messages.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}