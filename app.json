{
  "expo": {
    "name": "USay",
    "slug": "meetapp",
    "scheme": "meetapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetapp.social"
    },
    "android": {
      "package": "com.meetapp.social",
      "adaptiveIcon": {
        "backgroundColor": "#F5FAFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow USay to access your photos.",
          "cameraPermission": "Allow USay to use your camera."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow CUCKOO to record voice messages.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/cuckoo_default_natural.wav"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CUCKOO to record voice messages.",
          "speechRecognitionPermission": "Allow CUCKOO to transcribe voice messages.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
